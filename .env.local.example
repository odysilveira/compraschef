# Copie para .env.local quando o ambiente Supabase de staging existir.
# Enquanto estes valores não existem, o sistema roda com dados de exemplo (mock/localStorage).
# Use somente a URL e a anon key do ambiente de staging.
# Nunca coloque service_role no frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
